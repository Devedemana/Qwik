
generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// ----------------------- SCHEMAS --------------------------

model User {
  id               String   @id @default(uuid())
  cardId           Int ? 
  email            String   @unique
  name             String
  password         String
  role             Role     @default(CUSTOMER)
  dietaryLifestyle String[] // Postgres supports native scalar lists (arrays)
  allergies        String[]
  orders           Order[]
  createdAt        DateTime @default(now())

  workAtCafeteria  Cafeteria[]
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

model Cafeteria {
  id             String         @id @default(uuid())
  userId         String       
  name           String         @unique
  isOpen         Boolean        @default(true)
  capacityStatus CapacityStatus @default(GREEN)
  menuItems      MenuItem[]
  orders         Order[]
  workers        User[]
  }

enum CapacityStatus {
  GREEN
  YELLOW
  RED
}

model MenuItem {
  id           String    @id @default(uuid())
  cafeteriaId  String
  name         String
  description  String?
  price        Float
  category     String
  isAvailable  Boolean   @default(true)
  allergenTags String[]
  imageUrl     String?


  orderItems   OrderItem[] // not going to be used 
  cafeteria    Cafeteria @relation(fields: [cafeteriaId], references: [id])
}

model Order {
  id           String      @id @default(uuid())
  userId       String
  cafeteriaId  String
  totalAmount  Float
  status       OrderStatus @default(PENDING_PAYMENT)
  isPaid       Boolean     @default(false)
  pickupWindow DateTime
  qrCodeSecret String      @unique
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  items        OrderItem[]
  
  user         User        @relation(fields: [userId], references: [id])
  cafeteria    Cafeteria   @relation(fields: [cafeteriaId], references: [id])
}

model OrderItem {
  id          String @id @default(uuid())
  menuItemId  String
  quantity    Int

  orderId     String?
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id])
  order       Order? @relation(fields: [orderId], references: [id])
}

enum OrderStatus {
  PENDING_PAYMENT
  RECEIVED
  PREPPING
  READY
  COMPLETED
  CANCELLED
}